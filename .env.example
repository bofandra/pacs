# Development only. Do NOT use patient data in local prototyping.
DATABASE_URL=postgres://pacs:pacs_dev_only@127.0.0.1:5432/pacs
API_TOKEN=replace-with-a-long-random-development-secret
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
PACS_STORAGE_ROOT=./data/objects
PACS_INBOX_ROOT=./data/inbox
PACS_MAX_STOW_BYTES=67108864
PACS_AET=PACS_NATIVE
DICOM_BIND_IP=127.0.0.1
DICOM_PORT=11112
DICOM_SOURCE_PORT=11113

# Routing rules are disabled by default and require explicit operator enablement.
# Run npm run delivery:worker after applying migrations.

# Experimental Study Root C-FIND SCP. Must be explicitly opted in.
# Always listens on 127.0.0.1; only enabled registered IPv4 AE peers are accepted.
PACS_FIND_EXPERIMENTAL=0
PACS_FIND_PORT=11115

# Experimental C-MOVE SCP on same loopback query listener. Requires FIND opt-in.
# Only 127.0.0.1 destination IPv4 registered AEs allowed; max 10 instances.
PACS_MOVE_EXPERIMENTAL=0
